{
  "domain": "insteon",
  "name": "Insteon",
  "after_dependencies": ["panel_custom"],
  "categories": ["hubs_protocols.wireless_protocols"],
  "codeowners": ["@teharris1", "@ssyrell", "@connorgallopo"],
  "config_flow": true,
  "connectivity": ["insteon"],
  "dependencies": ["http", "usb", "websocket_api"],
  "dhcp": [
    {
      "macaddress": "000EF3*"
    },
    {
      "registered_devices": true
    }
  ],
  "documentation": "https://github.com/davecpearce/ha-insteon",
  "integration_type": "hub",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/davecpearce/ha-insteon/issues",
  "loggers": ["pyinsteon", "pypubsub"],
  "requirements": ["pyinsteon>=1.7.0,<1.8", "insteon-frontend-home-assistant>=0.7.0,<0.8"],
  "single_config_entry": true,
  "usb": [
    {
      "vid": "10BF"
    }
  ],
  "version": "1.4.1"
}
